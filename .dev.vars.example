# The default gives each browser its own private workspace.
FIELD_LOCAL_WORKSPACE="false"
# Only for the original single-user local checkout: set this to true.
# The setting is ignored in production and on non-loopback origins.

# Shared conversations: choose deepseek or ollama.
# Ollama is local-development only. It requires no key, dollar budget or rates.
# For local use: provider=ollama, model=your-model, concurrency=1.
# Start Ollama and pull the model before setting enabled=true.
FIELD_AI_ENABLED="false"
FIELD_AI_PROVIDER="deepseek"
FIELD_AI_KEY=""
FIELD_AI_MODEL="deepseek-v4-flash"
FIELD_AI_DAILY_USD=""
FIELD_AI_INPUT_USD_PER_MILLION=""
FIELD_AI_OUTPUT_USD_PER_MILLION=""
FIELD_AI_VISITOR_TURNS="20"
FIELD_AI_SITE_TURNS="1000"
FIELD_AI_CONCURRENCY="4"
FIELD_AI_MAX_OUTPUT="1200"

# Optional operator-owned X connection. Keep separate from visitor conversations.
FIELD_X_CLIENT_ID=""
FIELD_X_CLIENT_SECRET=""
FIELD_X_OWNER_KEY=""
FIELD_X_ENCRYPTION_KEY=""
FIELD_X_USER_ID=""
FIELD_X_ORIGIN=""

# Separate worker credential: draft generation only, no publication permission.
FIELD_NIA_WORKER_KEY=""
